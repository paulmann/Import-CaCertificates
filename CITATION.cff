    website: "https://github.com/paulmann"
version: "2.0.1"
date-released: "2026-11-06"
license: MIT
repository-code: "https://github.com/paulmann/Import-CaCertificates"
url: "https://paulmann.github.io/Import-CaCertificates/"
keywords:
